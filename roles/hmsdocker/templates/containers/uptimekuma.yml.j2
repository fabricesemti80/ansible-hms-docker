services:
  uptime-kuma:
    image: louislam/uptime-kuma:latest
    container_name: uptime-kuma
    restart: ${RESTART_POLICY}
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if hmsdocker_container_enabled_socketproxy | default(false) and socketproxy_expose_events | default(false) and socketproxy_expose_info | default(false) %}
    depends_on:
      - socketproxy
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/uptimekuma/config:/app/data
    {% if not (hmsdocker_container_enabled_socketproxy | default(false) and socketproxy_expose_events | default(false) and socketproxy_expose_info | default(false)) %}
      - /var/run/docker.sock:/var/run/docker.sock
    {% endif %}
    {% if hmsdocker_expose_ports_enabled_uptimekuma %}
    ports:
      - 3001:3001
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    {% if hmsdocker_container_enabled_socketproxy | default(false) and socketproxy_expose_events | default(false) and socketproxy_expose_info | default(false) %}
      - DOCKER_HOST=tcp://socketproxy:2375
    {% endif %}
    {% if hmsdocker_traefik_enabled_uptimekuma or hmsdocker_container_enabled_dockpeek %}
    labels:
      {% if hmsdocker_container_enabled_dockpeek %}
      - dockpeek.link=http://{{ hms_docker_container_map['uptimekuma']['proxy_host_rule'] | default('uptime-kuma') }}.${HMSD_DOMAIN}
      - dockpeek.ports=3001
      - dockpeek.tags=monitoring,uptime,alerts
      {% endif %}
      {% if hmsdocker_traefik_enabled_uptimekuma %}
      - traefik.enable=true
      - traefik.http.services.uptimekuma-${COMPOSE_PROJECT}.loadbalancer.server.port=3001
      - traefik.http.routers.uptimekuma-${COMPOSE_PROJECT}.rule=Host(`{{ hms_docker_container_map['uptimekuma']['proxy_host_rule'] | default('uptime-kuma') }}.${HMSD_DOMAIN}`)
        {% if not hmsdocker_expose_public_enabled_uptimekuma %}
      - traefik.http.routers.uptimekuma-${COMPOSE_PROJECT}.middlewares=internal-ipallowlist@file
        {% endif %}
        {% if hmsdocker_authentik_enabled_uptimekuma %}
      - traefik.http.routers.uptimekuma-${COMPOSE_PROJECT}.middlewares=authentik-proxy-${COMPOSE_PROJECT}-uptimekuma-midware@docker
        {% endif %}
      {% endif %}
    {% endif %}
