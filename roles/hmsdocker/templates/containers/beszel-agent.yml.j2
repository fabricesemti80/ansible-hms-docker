services:
  beszel-agent:
    image: henrygd/beszel-agent:latest
    container_name: beszel-agent
    restart: ${RESTART_POLICY}
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    environment:
      - PORT=45678
      - KEY=${BESZEL_AGENT_KEY}
    ports:
      - 45678:45678
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # monitor other disks / partitions by mounting them to /extra-filesystems
      # - /mnt/disk1:/extra-filesystems/disk1:ro
